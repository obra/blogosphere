#!/usr/bin/env bash
# ABOUTME: Pre-commit hook — auto-formats staged files, then gates the commit
# ABOUTME: on rustfmt, typecheck + tests. Installed via `git config core.hooksPath .githooks`.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Snapshot the staged file list before Biome may rewrite any of them, so we
# re-stage exactly what the developer intended to commit — nothing more.
staged_files="$(git diff --name-only --cached --diff-filter=ACMR)"

# Whole-repo scan, deliberately NOT --staged: Biome 2.5.4's staged/per-file mode
# panics on files with large transitive import graphs (module_resolver.rs index
# out of bounds) and its worker-thread panics don't fail the process. The
# directory scan takes <150ms here and is panic-free.
echo "[pre-commit] Formatting with Biome (whole repo)..."
if ! npx biome check --write .; then
  echo "[pre-commit] FAILED: Biome found problems it couldn't fix automatically." >&2
  echo "[pre-commit] Run 'npm run lint' to see details, fix them, and retry." >&2
  exit 1
fi

if [ -n "$staged_files" ]; then
  # xargs word-splits on whitespace/newlines; repo paths here don't contain
  # either, so plain newline-separated input is fine.
  echo "$staged_files" | xargs -I{} git add -- "{}"
fi

# CI runs `cargo fmt --check`; catch it here instead of on GitHub.
echo "[pre-commit] Checking Rust formatting..."
if ! (cd src-tauri && cargo fmt --check >/dev/null); then
  echo "[pre-commit] FAILED: Rust isn't rustfmt-formatted. Run '(cd src-tauri && cargo fmt)' and retry." >&2
  exit 1
fi

echo "[pre-commit] Typechecking..."
if ! npm run typecheck; then
  echo "[pre-commit] FAILED: typecheck failed. Fix the errors above and retry." >&2
  exit 1
fi

echo "[pre-commit] Running tests..."
if ! npm run test -- --run --silent; then
  echo "[pre-commit] FAILED: tests failed. Fix them and retry." >&2
  exit 1
fi

echo "[pre-commit] All checks passed."
